# Copy to /etc/health-check/env on the Pi 1, chmod 600, fill in real values.

# Control-plane Pi 5's IP or hostname (k3s API server, port 6443)
PI5_IP="<PI5_IP>"

# A workload endpoint served through the cluster's ingress, expected to
# return HTTP 200 when healthy
WORKLOAD_URL="<WORKLOAD_URL>"

# Discord webhook URL for the low-noise "all good" heartbeat channel
HEARTBEAT_WEBHOOK_URL="<HEARTBEAT_WEBHOOK_URL>"

# Discord webhook URL for the "something's wrong" alert channel
ALERT_WEBHOOK_URL="<ALERT_WEBHOOK_URL>"
